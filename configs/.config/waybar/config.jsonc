{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "height": 38,
  "spacing": 8,
  "modules-left": ["custom/launcher", "hyprland/taskbar", "hyprland/window"],
  "modules-center": [
    "cpu",
    "memory",
    "mpris",
    "custom/cava",
    "hyprland/workspaces",
    "clock#local",
    "clock",
    "custom/performance",
    "battery",
  ],
  "modules-right": ["tray", "custom/swaync", "network", "bluetooth", "custom/power"],
  "tray": {
    "icon-size": 16,
    "spacing": 6,
  },
  "custom/launcher": {
    "format": "󰣇",
    "on-click": "fuzzel",
    "tooltip": false,
  },
  "hyprland/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "on-click": "activate",
    "on-click-middle": "close",
    "tooltip-format": "{title}",
    "ignore-list": ["waybar"],
  },
  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 20,
  },
  "cpu": {
    "interval": 1,
    "format": "󰻠 {usage}%",
    "states": { "critical": 80 },
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
  },
  "mpris": {
    "format": "󰎆 {title}",
    "max-length": 40,
  },

  "hyprland/workspaces" : {
    "active-only" : false,
    "all-outputs" : true,
    "format" : "{icon}",
    "show-special" : false,
    "on-click" : "activate",
    "on-scroll-up" : "hyprctl dispatch workspace e+1",
    "on-scroll-down" : "hyprctl dispatch workspace e-1",
    "persistent-workspaces" : {
        "1" : [],
        "2" : [],
        "3" : [],
        "4" : [],
        "5" : [],
        "6" : [],
    },
    "format-icons" : {
        "1" : "I",
        "2" : "II",
        "3" : "III",
        "4" : "IV",
        "5" : "V",
        "6" : "VI",
        "7" : "VII",
        "8" : "VIII",
        "9" : "IX",
        "10" : "X",
    },
  },

  "clock#local": {
    "format": "{:%H:%M}",
    "tooltip": false,
  },
  "clock": {
    "timezone": "Africa/Nairobi",
    "format": "{:%H:%M · %a, %d/%m}",
    "on-click": "/home/ricedao/.local/bin/doot calendar toggle",
    "tooltip": false,
  },

  "custom/performance": {
    "format": "󰓅",
    "on-click": "powerprofilesctl set performance",
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂔 {capacity}%",
    "format-plugged": "󰨥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 30,
      "critical": 15,
    },
  },

  "network": {
    "format-wifi": "󰤨",
    "format-disconnected": "󰤵 ",
    "format-ethernet": "󰘀 ",
    "on-click": "nmrs",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)
IP: {ipaddr}",
  },
  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂯",
    "format-disabled": "󰂲",
    "on-click": "blueman-manager",
    "tooltip-format-connected": "{device_alias}",
    "tooltip-format-enumerate-connected": "{device_alias}",
  },
  "custom/swaync": {
    "format": "{icon}",
    "format-icons": {
      "none": "󰂚",
      "notification": "󰂚",
      "dnd-none": "󰂛",
      "dnd-notification": "󰂛",
    },
    "return-type": "json",
    "exec": "swaync-client -swb",
    "on-click": "swaync-client -t -sw",
    "on-click-right": "swaync-client -d -sw",
    "escape": true,
  },
  "custom/power": { "format": "", "on-click": "wlogout" },
}
