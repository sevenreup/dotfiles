{
  "reload_style_on_change": true,
  "layer": "top",
  "position": "top",
  "margin-top": 8,
  "margin-left": 12,
  "margin-right": 12,
  "height": 38,
  "spacing": 8,
  "modules-left": ["custom/launcher", "hyprland/taskbar", "hyprland/window"],
  "modules-center": [
    "cpu",
    "memory",
    "mpris",
    "custom/cava",
    "hyprland/workspaces",
    "clock",
    "custom/performance",
    "battery",
  ],
  "modules-right": ["network", "bluetooth", "custom/power"],
  "custom/launcher": {
    "format": "󰣇",
    "on-click": "rofi -show drun",
    "tooltip": false,
  },
  "hyprland/taskbar": {
    "format": "{icon}",
    "icon-size": 18,
    "on-click": "activate",
    "on-click-middle": "close",
    "tooltip-format": "{title}",
    "ignore-list": ["waybar"],
  },
  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 20,
  },
  "cpu": {
    "interval": 1,
    "format": "󰻠 {usage}%",
    "states": { "critical": 80 },
  },

  "memory": {
    "interval": 5,
    "format": "󰍛 {percentage}%",
  },
  "mpris": {
    "format": "󰎆 {title}",
    "max-length": 40,
  },
  "hyprland/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "all-outputs": true,
    "format-icons": {
      "active": "",
      "default": "",
    },
    "persistent-workspaces": { "*": [1, 2, 3, 4, 5, 6] },
  },

  "clock": { "format": "{:%H:%M · %a, %d/%m}" },

  "custom/performance": {
    "format": "󰓅",
    "on-click": "powerprofilesctl set performance",
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂔 {capacity}%",
    "format-plugged": "󰨥 {capacity}%",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "states": {
      "warning": 30,
      "critical": 15,
    },
  },

  "network": {
    "format-wifi": "󰤨",
    "format-disconnected": "󰤵 ",
    "format-ethernet": "󰘀 ",
    "on-click": "nm-connection-editor",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)
IP: {ipaddr}",
  },
  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂯",
    "format-disabled": "󰂲",
    "on-click": "blueman-manager",
    "tooltip-format-connected": "{device_alias}",
    "tooltip-format-enumerate-connected": "{device_alias}",
  },
  "custom/power": { "format": "", "on-click": "wlogout" },
}
